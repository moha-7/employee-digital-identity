Options -Indexes
RewriteEngine On

# Private application data must never be served directly.
RewriteRule ^(?:data|backups)(?:/|$) - [F,L,NC]

<FilesMatch "(^\.|\.(?:json|env|log|bak|sql)$)">
  Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^vcard/([A-Za-z0-9_-]+)/?$ index.php?vcard=$1 [L,QSA]
RewriteRule ^([A-Za-z0-9_-]+)/?$ index.php?employee=$1 [L,QSA]
RewriteRule ^$ index.php [L,QSA]
